    "test:browser": "node web/tests/browser.mjs",
    "test:persistence": "node web/tests/persistence.mjs",
    "test:offline": "node web/tests/offline.mjs",
    "test:capture": "node web/tests/capture.mjs",
    "test:controls": "node web/tests/controls.mjs",
    "test:performance": "node web/tests/performance.mjs",
    "test:clock": "node web/tests/clock-lifecycle.mjs",
    "test:offline-update": "node web/tests/offline-update.mjs",
    "test:save-pause": "node web/tests/save-pause.mjs",
    "test:calculator": "node web/tests/calculator.mjs",
    "test:notes": "node web/tests/organizer.mjs --notes",
