diff --git a/cctools/include/foreign/sys/sysctl.h b/cctools/include/foreign/sys/sysctl.h
index 30749d1..0d3baf9 100644
--- a/cctools/include/foreign/sys/sysctl.h
+++ b/cctools/include/foreign/sys/sysctl.h
@@ -1,3 +1,6 @@
+#if defined(__linux__)
+/* Linux removed this obsolete header. This port uses no Linux sysctl calls. */
+#else
 #ifndef __CYGWIN__
 #include_next <sys/sysctl.h>
 #else
@@ -20,3 +23,5 @@ int sysctl(const int *name, u_int namelen, void *oldp,	size_t *oldlenp,
 }
 #endif /* __SYSCTL_H__ */
 #endif /* ! __CYGWIN__ */
+
+#endif
diff --git a/cctools/ld64/src/ld/InputFiles.cpp b/cctools/ld64/src/ld/InputFiles.cpp
index 6b11cb4..87ca23c 100644
--- a/cctools/ld64/src/ld/InputFiles.cpp
+++ b/cctools/ld64/src/ld/InputFiles.cpp
@@ -742,9 +742,14 @@ InputFiles::InputFiles(Options& opts, const char** archName)
 	size_t len = sizeof(ncpus);
 	mib[0] = CTL_HW;
 	mib[1] = HW_NCPU;
+#if defined(__linux__)
+    long linux_ncpus = sysconf(_SC_NPROCESSORS_ONLN);
+    ncpus = linux_ncpus > 0 ? (unsigned int)linux_ncpus : 1;
+#else
 	if (sysctl(mib, 2, &ncpus, &len, NULL, 0) != 0) {
 		ncpus = 1;
 	}
+#endif
 	_availableWorkers = MIN(ncpus, files.size()); // max # workers we permit
 	_idleWorkers = 0;
 	
